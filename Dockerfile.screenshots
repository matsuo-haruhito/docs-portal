# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/playwright:v1.62.1-jammy

WORKDIR /opt/docs-portal

COPY package.json package-lock.json ./
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci

RUN mkdir -p /workspace && cp -a /opt/docs-portal/node_modules /workspace/node_modules

ENV NODE_PATH=/opt/docs-portal/node_modules
ENV PATH=/opt/docs-portal/node_modules/.bin:$PATH

WORKDIR /workspace
