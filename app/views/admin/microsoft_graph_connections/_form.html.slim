= render "shared/error_messages", record: microsoft_graph_connection

= form_with model: [:admin, microsoft_graph_connection] do |form|
  .form-grid
    = form.rfk_combobox :project_id,
      collection: [],
      selected: microsoft_graph_connection_project_selected_option(microsoft_graph_connection.project),
      url: project_search_admin_microsoft_graph_connections_path(format: :json),
      selected_url: selected_project_admin_microsoft_graph_connections_path(format: :json),
      value_field: "value",
      label_field: "text",
      search_field: "text",
      min_length: 1,
      max_options: Admin::MicrosoftGraphConnectionsController::PROJECT_SEARCH_LIMIT,
      wrapper: true,
      label: "案件",
      placeholder: "案件コード・案件名で検索"
    = form.rfk_text_field :name, wrapper: true, label: "接続名", placeholder: "Office preview"
    = form.rfk_enum_select :auth_type, wrapper: true, label: "認証方式"
    = form.rfk_text_field :tenant_id, wrapper: true, label: "Tenant ID"
    = form.rfk_text_field :client_id, wrapper: true, label: "Client ID"
    label
      | Client secret
      = form.password_field :client_secret, value: nil, autocomplete: "new-password", placeholder: microsoft_graph_connection.persisted? ? "変更時のみ入力" : "アプリのクライアントシークレット"
    = form.rfk_url_field :shared_folder_url, wrapper: true, label: "共有フォルダURL", placeholder: "https://contoso.sharepoint.com/..."
    = form.rfk_text_field :site_id, wrapper: true, label: "Site ID", placeholder: "任意。Drive IDの取得元を追跡するためのメモ"
    = form.rfk_text_field :drive_id, wrapper: true, label: "Drive ID", placeholder: "b!xxxxxxxx"
    = form.rfk_text_field :preview_folder_path, wrapper: true, label: "プレビュー用フォルダ", placeholder: "docs-portal-previews"
    = form.rfk_select :preview_selected,
      collection: [["使用する", true], ["使用しない", false]],
      wrapper: true,
      label: "Officeプレビューで使用"
    = form.rfk_select :enabled,
      collection: [["有効", true], ["無効", false]],
      wrapper: true,
      label: "状態"
  p.muted Officeファイルのプレビュー時に、指定Drive配下のプレビュー用フォルダへ一時アップロードし、Microsoft GraphのdriveItem preview URLを取得します。Client secretは暗号化カラムに保存されます。
  p.muted 同一案件で有効にできる Microsoft Graph 接続は 1 件だけです。切り替える場合は、現在の有効接続を先に無効化してから保存してください。
  p.muted SharePoint / OneDrive の共有フォルダURLが分かる場合は、Drive ID とプレビュー用フォルダ候補を取得できます。
  p.muted 取得操作はフォームに候補を反映するだけです。接続設定の保存は別途「保存」が必要です。
  p.actions
    = form.submit "保存", class: "button"
    = form.button "共有URLから候補を取得（保存しない）", name: "resolve_share_url", value: "1", class: "button secondary"
    - if microsoft_graph_connection.persisted?
      = back_link_to "一覧へ戻る", admin_microsoft_graph_connections_path
