- page_title "案件マスタ"
- table_key = :admin_projects
- table_columns = project_table_columns
- table_settings = rails_table_preference_settings(table_key: table_key)
- selected_active_filter = @project_filter_params["active"]
- selected_company_filter = @project_filter_params["company_id"]
- company_filter_options = admin_project_company_filter_collection(@selected_project_company, selected_company_filter)
- active_filter_labels = admin_project_filter_labels(@project_filter_params, @selected_project_company)

.admin-list-header
  h1 案件マスタ
  details.admin-create-panel open=(@project.errors.any?)
    summary.button.secondary
      i.bi.bi-plus-lg.me-1 aria-hidden="true"
      | 新規登録
    .admin-create-panel__body
      = render "form", project: @project

.admin-filter-toolbar
  = form_with url: admin_projects_path, method: :get, local: true, class: "admin-filter-toolbar__form" do |form|
    .admin-filter-toolbar__fields
      = form.rfk_search_field :q,
        value: @project_filter_params["q"],
        placeholder: "コード・案件名・説明",
        wrapper: false,
        html: { maxlength: 100, class: "admin-filter-toolbar__search" }
      = form.rfk_select :active,
        collection: [["有効", "true"], ["無効", "false"]],
        selected: (%w[true false].include?(selected_active_filter) ? selected_active_filter : nil),
        include_blank: "すべて",
        wrapper: false,
        allow_clear: true,
        placeholder: "状態"
      = form.rfk_combobox :company_id,
        collection: company_filter_options,
        selected: admin_project_company_filter_selected_option(@selected_project_company, selected_company_filter),
        url: company_search_admin_projects_path(format: :json),
        selected_url: selected_company_admin_projects_path(format: :json),
        value_field: "value",
        label_field: "text",
        search_field: "text",
        min_length: 1,
        max_options: Admin::ProjectsController::COMPANY_SEARCH_LIMIT,
        wrapper: false,
        placeholder: "会社名・ドメインで検索",
        allow_clear: true
    .admin-filter-toolbar__actions
      = form.submit "検索", class: "button"
      - if active_filter_labels.any?
        = link_to "クリア", admin_projects_path, class: "button secondary"

- if active_filter_labels.any?
  .admin-filter-chips
    - active_filter_labels.each do |label|
      span.admin-filter-chip = label

.admin-list-meta
  span.admin-list-meta__count = "#{@projects_filtered_count}件"
  - if @projects.any?
    = render ColumnSettingsComponent.new(table_key: table_key, settings: table_settings, columns: table_columns, title: "案件一覧の表示設定")

- if @projects.any?
  = table_preferences_table_tag(table_key: table_key, settings: table_settings, columns: table_columns) do
    thead
      tr
        th data-rails-table-preferences-column-key="code" コード
        th data-rails-table-preferences-column-key="name" 案件名
        th data-rails-table-preferences-column-key="company" 企業
        th data-rails-table-preferences-column-key="description" 説明
        th data-rails-table-preferences-column-key="status" 状態
        th data-rails-table-preferences-column-key="actions" 操作
    tbody
      - @projects.each do |project|
        - project_delete_company_label = project.company&.display_name || "企業未設定"
        - project_delete_confirm = "案件「#{project.name}」（コード: #{project.code} / 企業: #{project_delete_company_label}）を削除しますか？関連文書や所属設定に影響します。"
        tr
          td data-rails-table-preferences-column-key="code" = project.code
          td data-rails-table-preferences-column-key="name" = project.name
          td data-rails-table-preferences-column-key="company" = project.company&.display_name || "未設定"
          td data-rails-table-preferences-column-key="description" = project.description
          td data-rails-table-preferences-column-key="status"
            - if project.active?
              = render StatusBadgeComponent.new(status: "active", label: "有効")
            - else
              = render StatusBadgeComponent.new(status: "inactive", label: "無効")
          td.actions data-rails-table-preferences-column-key="actions"
            = edit_link_to "編集", edit_admin_project_path(project)
            = delete_link_to "削除", admin_project_path(project), confirm: project_delete_confirm

  - if @projects_pagination[:total_pages] > 1
    nav.pagination aria-label="案件一覧ページ"
      .admin-pagination
        - if @projects_pagination[:prev_page]
          = link_to "前へ", admin_projects_path(@project_page_params.merge(page: @projects_pagination[:prev_page])), class: "button secondary"
        span.muted = "#{@projects_pagination[:page]} / #{@projects_pagination[:total_pages]}"
        - if @projects_pagination[:next_page]
          = link_to "次へ", admin_projects_path(@project_page_params.merge(page: @projects_pagination[:next_page])), class: "button secondary"
- elsif @projects_total_count.to_i.zero?
  = render EmptyStateComponent.new(heading: "案件が未登録です", description: "「新規登録」でコードと案件名を入力してください。")
- else
  = render EmptyStateComponent.new(heading: "条件に一致する案件がありません", description: "キーワード、状態、企業の条件を変更するか、条件をクリアしてください。") do |component|
    - if active_filter_labels.any?
      - component.with_action do
        = link_to "条件をクリア", admin_projects_path, class: "button secondary"
