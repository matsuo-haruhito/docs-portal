- if company_master_admin? && !admin_user?
  nav.admin-context-nav aria-label="会社・ユーザー管理"
    ul.nav-list
      - current_path = request.path
      - path_active = ->(path) { current_path == path || current_path.start_with?("#{path}/") }
      li = link_to "会社", admin_companies_path, class: ("fw-bold" if path_active.call(admin_companies_path)), aria: ({ current: "page" } if path_active.call(admin_companies_path))
      li = link_to "ユーザー", admin_users_path, class: ("fw-bold" if path_active.call(admin_users_path)), aria: ({ current: "page" } if path_active.call(admin_users_path))
