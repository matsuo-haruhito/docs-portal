- detail_path_params = { return_to: request.fullpath }
- status_filter_params = request.query_parameters.except(:page, :per_page).compact_blank
- current_status_filter = @filters[:status].presence
- status_quick_link_base_class = "rounded border px-3 py-2"
- status_quick_link_current_class = "#{status_quick_link_base_class} border-blue-600 bg-blue-50 font-semibold text-blue-700 ring-2 ring-blue-100"
- status_quick_link_default_class = "#{status_quick_link_base_class} text-gray-700 hover:bg-gray-50"
- has_active_filters = @filters.compact_blank.any?
- filter_summary_items = generated_file_event_filter_summary_items(@filters)
- bulk_retry_target_count = @bulk_retry_target_count.to_i
- bulk_retry_available = bulk_retry_target_count.positive?
- bulk_retry_confirm_message = "現在の条件で今回再投入する失敗イベント #{bulk_retry_target_count} 件を、古い順に最大100件まで一括再投入します。現在の条件を確認してから実行してください。実行しますか？"
- bulk_retry_form_options = bulk_retry_available ? { data: { turbo_confirm: bulk_retry_confirm_message } } : {}
- table_key = :admin_generated_file_events
- table_columns = generated_file_event_table_columns
- table_settings = rails_table_preference_settings(table_key: table_key)
- query_max_length = Admin::GeneratedFileEventsController::QUERY_MAX_LENGTH
- page_offset = (@page - 1) * @per_page
- page_start = @total_count.zero? ? 0 : page_offset + 1
- page_end = page_offset + @generated_file_events.size
- pagination = { page: @page, total_pages: @total_pages, total_count: @total_count, from: page_start, to: page_end }
- pagination_params = request.query_parameters.merge(per_page: @per_page)

.space-y-6
  .flex.items-start.justify-between.gap-4
    div
      h1.text-2xl.font-bold 生成ファイルイベント
      p.text-sm.text-gray-600 debounce / coalesce 用に蓄積されたファイル変更イベントです。
    div class="flex flex-col gap-3 text-sm md:flex-row md:items-start md:justify-end"
      - bulk_retry_class = "rounded bg-blue-600 px-3 py-2 text-sm text-white"
      - bulk_retry_class = "rounded bg-gray-300 px-3 py-2 text-sm text-gray-600" unless bulk_retry_available
      - bulk_retry_class = "rounded bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow" if bulk_retry_available && @filters[:status] == "failed"
      .rounded.border.border-red-100.bg-red-50.p-3.text-left
        p.text-xs.font-semibold.uppercase.text-red-700 実行操作
        .mt-2.flex.flex-wrap.items-center.gap-2
          = button_to "失敗分を一括再投入", retry_failed_admin_generated_file_events_path(@filters.compact_blank), method: :post, class: bulk_retry_class, disabled: !bulk_retry_available, form: bulk_retry_form_options
        p.mt-2.text-xs.text-gray-600 再投入は表示件数や表示設定ではなく、現在の条件に一致する失敗イベントだけを対象にする操作です。
        p.mt-1.text-xs.text-gray-500 = "今回の一括再投入対象: #{@bulk_retry_target_count} 件"
        p.text-xs.text-gray-500 現在の条件で今回再投入する失敗イベントを、古い順に最大100件まで処理します。
        - unless bulk_retry_available
          p.text-xs.text-gray-500 対象がないため一括再投入できません。
      .rounded.border.bg-white.p-3.text-left
        p.text-xs.font-semibold.uppercase.text-gray-600 表示フィルタ
        .mt-2.flex.flex-wrap.items-center.gap-2
          - all_status_current = current_status_filter.blank?
          = link_to "すべて", admin_generated_file_events_path(status_filter_params.except("status")), class: all_status_current ? status_quick_link_current_class : status_quick_link_default_class, aria: (all_status_current ? { current: "page" } : {})
          - GeneratedFileEvent.statuses.keys.each do |status|
            - status_current = current_status_filter == status
            = link_to generated_file_event_status_label(status), admin_generated_file_events_path(status_filter_params.merge("status" => status)), class: status_current ? status_quick_link_current_class : status_quick_link_default_class, aria: (status_current ? { current: "page" } : {})

  div class="grid grid-cols-2 gap-3 md:grid-cols-4"
    - GeneratedFileEvent.statuses.keys.each do |status|
      = link_to admin_generated_file_events_path(status_filter_params.merge("status" => status)), class: "rounded-lg border bg-white p-4" do
        .text-xs.font-semibold.uppercase.text-gray-500 = generated_file_event_status_label(status)
        .mt-1.text-2xl.font-bold = @status_counts.fetch(status, 0)

  - if @filter_warnings.present?
    .rounded.border.border-amber-300.bg-amber-50.p-3.text-sm.text-amber-900
      p.font-semibold 日時フィルタを確認してください。
      ul.mt-1.list-disc.pl-5
        - @filter_warnings.each do |warning|
          li = warning

  = form_with url: admin_generated_file_events_path, method: :get, local: true do |form|
    = render FilterToolbarComponent.new(label: "生成ファイルイベントの検索条件") do |toolbar|
      - toolbar.with_field(size: :query) do
        label
          | イベントID / パス / エラー
          = form.rfk_search_field :q,
            value: @filters[:q],
            wrapper: false,
            html: { maxlength: query_max_length, aria: { label: "イベントID、パス、エラーで検索" } }
      - toolbar.with_field(size: :enum) do
        = form.rfk_select :status,
          collection: GeneratedFileEvent.statuses.keys.map { [generated_file_event_status_label(_1), _1] },
          selected: @filters[:status].presence,
          include_blank: "すべて",
          wrapper: true,
          label: "状態",
          allow_clear: true,
          placeholder: "すべて"
      - toolbar.with_field(size: :enum) do
        = form.rfk_select :operation,
          collection: %w[create update delete].map { [generated_file_operation_label(_1), _1] },
          selected: @filters[:operation].presence,
          include_blank: "すべて",
          wrapper: true,
          label: "操作種別",
          allow_clear: true,
          placeholder: "すべて"
      - toolbar.with_field(size: :short) do
        label
          | イベント発生元
          = form.text_field :event_source, value: @filters[:event_source]
      - toolbar.with_field(size: :wide) do
        label
          | パスを含む
          = form.text_field :path, value: @filters[:path], maxlength: query_max_length
      - toolbar.with_field(size: :date) do
        label
          | 実行予定日(開始)
          = form.text_field :scheduled_from, value: @filters[:scheduled_from], placeholder: "YYYY-MM-DD"
      - toolbar.with_field(size: :date) do
        label
          | 実行予定日(終了)
          = form.text_field :scheduled_to, value: @filters[:scheduled_to], placeholder: "YYYY-MM-DD"
      - toolbar.with_action do
        = form.submit "絞り込み", class: "button"
      - if has_active_filters
        - toolbar.with_action do
          = link_to "絞り込みを解除", admin_generated_file_events_path, class: "button secondary"
      - toolbar.with_details do
        = render GuidanceDisclosureComponent.new(title: "検索条件の補足") do
          ul
            li 最大100文字。イベントID、パス、エラーの短い断片で探します。パス内の \\ は / として検索します。
            li 保存値と完全一致する発生元だけに絞り込みます。短い断片で探す場合は「イベントID / パス / エラー」を使ってください。
            li 最大100文字。Windowsの区切り文字 \\ は / として検索します。
            li 日付だけ指定すると、その日の00:00以降を含みます。
            li 日付だけ指定すると、その日の23:59までを含みます。

  - if @generated_file_events.any? && filter_summary_items.any?
    .generated-file-event-filter-summary.rounded-lg.border.border-blue-100.bg-blue-50.p-4.text-sm.text-blue-950
      div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between"
        div
          p.font-semibold 現在の表示条件
          ul.mt-2.flex.flex-wrap.gap-2
            - filter_summary_items.each do |item|
              li.rounded.border.border-blue-200.bg-white.px-2.py-1 = item
          p.mt-2.text-xs.text-blue-900 これは表示フィルタの読み返しです。一括再投入は、この条件に一致する失敗イベントだけを古い順に最大100件まで対象にします。
        = link_to "絞り込みを解除", admin_generated_file_events_path, class: "shrink-0 rounded border border-blue-200 bg-white px-3 py-2 text-sm text-blue-700"

  - if @generated_file_events.any?
    .rounded-lg.border.bg-white.p-4
      = render ColumnSettingsComponent.new(table_key: table_key, settings: table_settings, columns: table_columns, title: "生成ファイルイベント一覧の表示設定")

  .overflow-x-auto.rounded-lg.border.bg-white
    = table_preferences_table_tag(table_key: table_key, settings: table_settings, columns: table_columns) do
      thead.bg-gray-50
        tr
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="public_id" イベントID
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="status" 状態
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="path" パス
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="operation" 操作種別
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="event_source" 発生元
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="error_message" エラー
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="occurrences_count" 回数
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="scheduled_at" 実行予定
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="processed_at" 処理完了
          th.px-4.py-3.text-left.font-semibold data-rails-table-preferences-column-key="actions" 操作
      tbody.divide-y.divide-gray-100
        - if @generated_file_events.any?
          - @generated_file_events.each do |event|
            - event_detail_action_label = "#{event.public_id} / #{generated_file_event_status_label(event.status)} / #{generated_file_operation_label(event.operation)} の詳細を開く"
            tr
              td.px-4.py-3.font-mono data-rails-table-preferences-column-key="public_id"
                = link_to event.public_id, admin_generated_file_event_path(event.public_id, detail_path_params), class: "text-blue-600 underline"
              td.px-4.py-3 data-rails-table-preferences-column-key="status" = generated_file_event_status_label(event.status)
              td.px-4.py-3.font-mono data-rails-table-preferences-column-key="path" = event.path
              td.px-4.py-3 data-rails-table-preferences-column-key="operation" = generated_file_operation_label(event.operation)
              td.px-4.py-3 data-rails-table-preferences-column-key="event_source" = generated_file_source_label(event.event_source)
              td.max-w-xs.truncate.px-4.py-3.text-gray-700 data-rails-table-preferences-column-key="error_message" = generated_file_event_error_preview(event.error_message)
              td.px-4.py-3 data-rails-table-preferences-column-key="occurrences_count" = event.occurrences_count
              td.px-4.py-3 data-rails-table-preferences-column-key="scheduled_at" = l(event.scheduled_at, format: :long) if event.scheduled_at
              td.px-4.py-3 data-rails-table-preferences-column-key="processed_at" = l(event.processed_at, format: :long) if event.processed_at
              td.px-4.py-3 data-rails-table-preferences-column-key="actions"
                .flex.gap-2
                  = link_to "詳細", admin_generated_file_event_path(event.public_id, detail_path_params), class: "rounded border px-2 py-1 text-xs", title: event_detail_action_label, aria: { label: event_detail_action_label }
                  = button_to "この1件を再投入", retry_dispatch_admin_generated_file_event_path(event.public_id), method: :post, class: "rounded bg-blue-600 px-2 py-1 text-xs text-white", title: "#{event.public_id} 1件を再投入キューに投入（一括再投入ではありません）", aria: { label: "#{event.public_id} 1件を再投入キューに投入（一括再投入ではありません）" }
        - else
          tr
            td.px-4.py-8.text-center.text-gray-500 colspan=table_columns.size
              - if has_active_filters
                .generated-file-event-filter-empty-state.space-y-2
                  p 検索条件に一致する生成ファイルイベントはありません。
                  p.text-sm これは表示フィルタの結果です。一括再投入対象の有無とは別に、条件を見直すか、すべての生成ファイルイベントを表示してください。
                  p.actions.mt-3 = link_to "すべての生成ファイルイベントを見る", admin_generated_file_events_path, class: "rounded border px-3 py-2 text-sm"
              - else
                .generated-file-event-initial-empty-state.space-y-2
                  p 生成ファイルイベントはまだありません。
                  p.text-sm 生成対象のファイル変更イベントが蓄積されると、ここに debounce / coalesce 後のイベントが表示されます。イベント 0 件は、生成処理が成功していることやエラーがないことを示すものではありません。
                  p.actions.mt-3 = link_to "生成ファイル実行履歴を確認する", admin_generated_file_runs_path, class: "rounded border px-3 py-2 text-sm"

  = render ListFooterComponent.new(pagination: pagination, url: admin_generated_file_events_path, params: pagination_params, label: "生成ファイルイベント一覧")
