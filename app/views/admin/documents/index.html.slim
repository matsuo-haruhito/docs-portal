- page_title "文書マスタ"
- table_key = :admin_documents
- table_columns = document_table_columns
- table_settings = rails_table_preference_settings(table_key: table_key)
- has_lifecycle_filter = @filters.values_at(:retention, :discard).any?(&:present?)
- detailed_filters_active = @filters.values_at(:category, :document_kind, :visibility_policy, :source_authority, :retention, :discard).any?(&:present?)
- active_filter_summaries = admin_document_active_filter_summaries(@filters)
- filters_active = active_filter_summaries.any?
- documents_empty = @documents_filtered_count.zero?
- current_return_to = request.query_string.present? ? request.fullpath : nil
- document_pagination = @documents_pagination

.admin-list-header
  h1 文書マスタ
  details.admin-create-panel open=(@document.errors.any?)
    summary.button.secondary
      i.bi.bi-plus-lg.me-1 aria-hidden="true"
      | 新規登録
    .admin-create-panel__body
      = render "form", document: @document

= form_with url: admin_documents_path, method: :get, local: true, class: "admin-filter-toolbar__form" do |form|
  = render FilterToolbarComponent.new(label: "文書マスタの検索条件") do |toolbar|
    - toolbar.with_field(size: :query) do
      label
        | 案件・文書
        = form.rfk_search_field :q,
          value: @filters[:q],
          placeholder: "案件名・案件コード・文書名・URL識別子",
          wrapper: false,
          html: { maxlength: Admin::DocumentsController::DOCUMENT_SEARCH_QUERY_MAX_LENGTH, class: "admin-filter-toolbar__search" }
    - toolbar.with_field(size: :enum) do
      = form.rfk_select :archived,
        collection: admin_document_archived_filter_options.drop(1),
        include_blank: "すべて",
        placeholder: "すべて",
        selected: @filters[:archived],
        allow_clear: true,
        wrapper: true,
        label: "アーカイブ状態"
    - toolbar.with_action do
      = form.submit "検索", class: "button"
    - if filters_active
      - toolbar.with_action do
        = link_to "条件をクリア", admin_documents_path, class: "button secondary"
    - active_filter_summaries.each do |summary|
      - toolbar.with_active_filter do
        = summary
    - toolbar.with_details do
      details.filter-details open=(detailed_filters_active ? true : nil)
        summary 詳細条件
        .filter-toolbar__fields
          .filter-toolbar__field.filter-toolbar__field--enum
            = form.rfk_select :category,
              collection: admin_document_category_filter_options.drop(1),
              include_blank: "すべて",
              placeholder: "すべて",
              selected: @filters[:category],
              allow_clear: true,
              wrapper: true,
              label: "カテゴリ"
          .filter-toolbar__field.filter-toolbar__field--enum
            = form.rfk_select :document_kind,
              collection: admin_document_kind_filter_options.drop(1),
              include_blank: "すべて",
              placeholder: "すべて",
              selected: @filters[:document_kind],
              allow_clear: true,
              wrapper: true,
              label: "種別"
          .filter-toolbar__field.filter-toolbar__field--enum
            = form.rfk_select :visibility_policy,
              collection: admin_document_visibility_filter_options.drop(1),
              include_blank: "すべて",
              placeholder: "すべて",
              selected: @filters[:visibility_policy],
              allow_clear: true,
              wrapper: true,
              label: "公開範囲"
          .filter-toolbar__field.filter-toolbar__field--enum
            = form.rfk_select :source_authority,
              collection: admin_document_source_authority_filter_options.drop(1),
              include_blank: "すべて",
              placeholder: "すべて",
              selected: @filters[:source_authority],
              allow_clear: true,
              wrapper: true,
              label: "正本区分"
          .filter-toolbar__field.filter-toolbar__field--enum
            = form.rfk_select :retention,
              collection: admin_document_retention_filter_options.drop(1),
              include_blank: "すべて",
              placeholder: "すべて",
              selected: @filters[:retention],
              allow_clear: true,
              wrapper: true,
              label: "保管期限"
          .filter-toolbar__field.filter-toolbar__field--enum
            = form.rfk_select :discard,
              collection: admin_document_discard_filter_options.drop(1),
              include_blank: "すべて",
              placeholder: "すべて",
              selected: @filters[:discard],
              allow_clear: true,
              wrapper: true,
              label: "廃棄候補"

.admin-list-meta
  span.admin-list-meta__count = "#{@documents_filtered_count}件"
  div hidden=(documents_empty ? true : nil)
    = render ColumnSettingsComponent.new(table_key: table_key, settings: table_settings, columns: table_columns, title: "文書マスタ一覧の表示設定", description: "文書マスタ一覧の表示設定と検索条件は、この一覧の列表示・列幅・表示件数にだけ適用されます。文書詳細の左ペインにある文書ツリーの表示状態とは別です。")

- if has_lifecycle_filter
  details.filter-details
    summary lifecycle確認
    p.muted 保管期限・廃棄候補の絞り込み結果をread-onlyで引き継ぎます。archive、restore、discard、deleteは実行しません。
    p.actions
      = link_to "handoff JSONを確認", lifecycle_handoff_admin_documents_path(@document_page_params.merge(format: :json)), class: "button secondary"

details.filter-details
  summary 一括操作
  .actions.form-actions
    - if @bulk_edit_candidate_count.zero?
      span.muted 一括編集候補: 0件
    - elsif @bulk_edit_candidate_count > @bulk_edit_candidate_limit
      span = "一括編集候補: #{@bulk_edit_candidate_count}件"
      = render HelpTooltipComponent.new(description: "一括編集へ進むには、検索条件で#{@bulk_edit_candidate_limit}件以下まで絞り込んでください。")
    - else
      = link_to "一括編集候補として開く", new_admin_bulk_edit_dry_run_path(source: "admin_documents", candidate_document_ids: @bulk_edit_candidate_ids, source_filter_summaries: active_filter_summaries), class: "button secondary"
      = render HelpTooltipComponent.new(description: "現在の検索結果#{@bulk_edit_candidate_count}件をdry-runへ引き継ぎます。この操作だけでは文書を変更しません。")
  - if @bulk_edit_candidate_count.positive? && @bulk_edit_candidate_count <= @bulk_edit_candidate_limit
    .actions.form-actions
      - if @bulk_archive_candidate_count.positive?
        = link_to "アーカイブdry-run候補", new_admin_bulk_edit_dry_run_path(source: "admin_documents", lifecycle_purpose: "archive", candidate_document_ids: @bulk_archive_candidate_ids, source_filter_summaries: active_filter_summaries + ["目的: archive dry-run", "対象状態: 有効"]), class: "button secondary"
      - if @bulk_restore_candidate_count.positive?
        = link_to "復元dry-run候補", new_admin_bulk_edit_dry_run_path(source: "admin_documents", lifecycle_purpose: "restore", candidate_document_ids: @bulk_restore_candidate_ids, source_filter_summaries: active_filter_summaries + ["目的: restore dry-run", "対象状態: アーカイブ済み"]), class: "button secondary"

- if documents_empty
  .card.document-list-empty-guidance
    - if filters_active
      = render EmptyStateComponent.new(heading: "条件に一致する文書がありません", description: "条件を見直すか、文書マスタ全体へ戻ってください。") do |component|
        - component.with_action do
          = link_to "条件をクリア", admin_documents_path, class: "button secondary"
    - else
      = render EmptyStateComponent.new(heading: "文書が未登録です", description: "「新規登録」で最初の文書を追加してください。")
  style
    | table[data-rails-table-preferences-table-key-value="admin_documents"] { display: none; }

= table_preferences_table_tag(table_key: table_key, settings: table_settings, columns: table_columns, scroll_wrapper: true, wrapper_options: { class: "table-scroll", role: "region", tabindex: 0, aria: { label: "文書マスタ一覧" } }) do
  caption.table-caption 文書マスタ一覧
  thead
    tr
      th data-rails-table-preferences-column-key="project" 案件
      th data-rails-table-preferences-column-key="title" 文書名
      th data-rails-table-preferences-column-key="slug" URL識別子
      th data-rails-table-preferences-column-key="category" カテゴリ
      th data-rails-table-preferences-column-key="document_kind" 種別
      th data-rails-table-preferences-column-key="visibility_policy" 公開範囲
      th data-rails-table-preferences-column-key="source_authority"
        | 正本区分
        = render InfoTooltipComponent.new(label: "正本区分", description: "本文を更新する正本システムです。外部正本の場合は更新先へ引き継ぎます。")
      th data-rails-table-preferences-column-key="status" 状態
      th data-rails-table-preferences-column-key="latest_version"
        | 最新版/HTML
        = render InfoTooltipComponent.new(label: "最新版とHTML", description: "最新版の版・公開状態・公開期間と、HTMLプレビューの生成状態をまとめて表示します。")
      th data-rails-table-preferences-column-key="legacy_versions" 古い版候補
      th data-rails-table-preferences-column-key="retention_until" 保管期限
      th data-rails-table-preferences-column-key="discard_candidate_at" 廃棄候補
      th data-rails-table-preferences-column-key="discard_review" 廃棄候補の確認
      th data-rails-table-preferences-column-key="actions"
  tbody
    - @documents.each do |document|
      - latest_version = document.latest_version
      - legacy_versions = admin_document_legacy_versions(document)
      tr
        td data-rails-table-preferences-column-key="project"
          div = document.project.name
          - if admin_document_project_secondary_label(document.project)
            div.muted = admin_document_project_secondary_label(document.project)
        td data-rails-table-preferences-column-key="title" = link_to document.title, project_document_path(document.project, document.slug), data: { turbo_frame: "_top" }
        td data-rails-table-preferences-column-key="slug" = document.slug
        td data-rails-table-preferences-column-key="category"
          span.badge = document_category_label(document)
        td data-rails-table-preferences-column-key="document_kind" = document_kind_label(document)
        td data-rails-table-preferences-column-key="visibility_policy" = document_visibility_policy_label(document)
        td data-rails-table-preferences-column-key="source_authority"
          span.badge = localized_label("documents.source_authority", document.source_authority)
        td data-rails-table-preferences-column-key="status"
          - if document.archived?
            = render StatusBadgeComponent.new(status: "archived", label: "アーカイブ済み", tooltip: "この文書はアーカイブされています。公開側では表示されません。")
            br
            span.muted = "実行者: #{document.archived_by_user&.name || '-'}"
          - else
            = render StatusBadgeComponent.new(status: "active", label: "有効", tooltip: "この文書は有効です。権限に応じて公開側に表示されます。")
        td data-rails-table-preferences-column-key="latest_version"
          - if latest_version
            span.badge = document_version_label(latest_version)
            span.muted = " #{document_version_status_label(latest_version)}"
            br
            span.muted = "#{admin_document_latest_version_publication_label(latest_version)} / #{admin_document_latest_version_preview_label(latest_version)}"
          - else
            span.muted 最新版なし
            br
            span.muted 公開版未選択
        td data-rails-table-preferences-column-key="legacy_versions"
          - if legacy_versions.any?
            span.badge = "#{legacy_versions.size}件"
            - legacy_versions.first(3).each do |version|
              div
                span = document_version_label(version)
                span.muted = " / #{document_version_status_label(version)}"
                br
                span.muted = admin_document_legacy_version_source_label(version)
                br
                span.muted = "更新: #{l(version.updated_at)}"
                - if version.published?
                  - promote_version_cue = "公開済みの#{document_version_label(version)}を最新版に指定します。"
                  = button_to "最新版に指定", promote_latest_version_admin_document_path(document.public_id, version_id: version.public_id, return_to: current_return_to), method: :patch, class: "button secondary", aria: { label: promote_version_cue }, title: promote_version_cue, form: { data: { turbo_confirm: "#{promote_version_cue}よろしいですか？" } }
            - if legacy_versions.size > 3
              div.muted = "ほか#{legacy_versions.size - 3}件"
          - else
            span.muted 候補なし
        td data-rails-table-preferences-column-key="retention_until" = document.retention_until ? l(document.retention_until) : "-"
        td data-rails-table-preferences-column-key="discard_candidate_at" = document.discard_candidate_at ? l(document.discard_candidate_at) : "-"
        td data-rails-table-preferences-column-key="discard_review"
          - if document.discard_reviewed_at.present?
            = l(document.discard_reviewed_at)
            br
            span.muted = document.discard_reviewed_by&.name || "-"
          - else
            span.muted -
          - if document.discard_candidate_at.present?
            - discard_review_cue = "廃棄候補日を変更せず、確認者と確認日時だけを記録します。"
            = button_to "確認を記録", mark_discard_reviewed_admin_document_path(document.public_id, return_to: current_return_to), method: :patch, class: "button secondary", aria: { label: discard_review_cue }, title: discard_review_cue
        td.actions.document-row-actions data-rails-table-preferences-column-key="actions"
          - edit_document_cue = "文書「#{document.title}」を編集"
          = link_to edit_admin_document_path(document.public_id, return_to: current_return_to), class: "button secondary", aria: { label: edit_document_cue }, title: edit_document_cue do
            i.bi.bi-pencil aria-hidden="true"
            span.visually-hidden 編集
          - if document.archived?
            - restore_document_cue = "文書「#{document.title}」を復元します。通常一覧・社外導線で再び表示対象になる可能性があります。"
            = button_to restore_admin_document_path(document.public_id, return_to: current_return_to), method: :patch, class: "button secondary", aria: { label: restore_document_cue }, title: restore_document_cue, form: { data: { turbo_confirm: "#{restore_document_cue}よろしいですか？" } } do
              i.bi.bi-arrow-counterclockwise aria-hidden="true"
              span.visually-hidden 復元
          - else
            - archive_document_cue = "文書「#{document.title}」をアーカイブします。通常一覧・社外導線から非表示になります。復元は管理画面から実行できます。"
            = button_to archive_admin_document_path(document.public_id, return_to: current_return_to), method: :patch, params: { retention_until: document.retention_until, discard_candidate_at: document.discard_candidate_at }, class: "button secondary", aria: { label: archive_document_cue }, title: archive_document_cue, form: { data: { turbo_confirm: "#{archive_document_cue}よろしいですか？" } } do
              i.bi.bi-archive aria-hidden="true"
              span.visually-hidden アーカイブ
          - delete_document_cue = "文書「#{document.title}」を削除"
          = button_to admin_document_path(document.public_id, return_to: current_return_to), method: :delete, class: "button danger", aria: { label: delete_document_cue }, title: delete_document_cue, form: { data: { turbo_confirm: "文書「#{document.title}」を削除しますか？関連する版・添付・コメントも削除される可能性があります。" } } do
            i.bi.bi-trash aria-hidden="true"
            span.visually-hidden 削除

- unless documents_empty
  = render ListFooterComponent.new(pagination: document_pagination, url: admin_documents_path, params: @document_page_params, label: "文書マスタ一覧")
