- return_to_path = @return_to_path || admin_generated_file_runs_path
- search_hints = generated_file_run_search_hints(@generated_file_run)

.space-y-6
  .flex.items-start.justify-between.gap-4
    div
      h1.text-2xl.font-bold 生成ファイル実行履歴
      p.font-mono.text-sm.text-gray-600 = @generated_file_run.public_id
    .flex.max-w-md.flex-col.items-end.gap-2.text-right
      .flex.gap-2
        = link_to "一覧へ戻る", return_to_path, class: "rounded border px-3 py-2 text-sm"
        = button_to "この実行を再実行", retry_run_admin_generated_file_run_path(@generated_file_run.public_id, return_to: return_to_path), method: :post, class: "rounded bg-blue-600 px-3 py-2 text-sm text-white", title: "#{@generated_file_run.public_id} を再実行キューに投入", aria: { label: "#{@generated_file_run.public_id} を再実行キューに投入" }
      p.text-xs.text-gray-500 この実行1件だけを再実行キューへ投入します。元の実行履歴は診断用に残り、新しい実行IDで再実行後の結果を確認します。

  .rounded-lg.border.bg-white.p-4
    h2.mb-3.text-lg.font-semibold 概要
    dl class="grid grid-cols-1 gap-3 text-sm md:grid-cols-2"
      div
        dt.font-semibold 状態
        dd = generated_file_run_status_label(@generated_file_run.status)
      div
        dt.font-semibold ジョブID
        dd.font-mono = @generated_file_run.job_id
      div
        dt.font-semibold ジェネレータ
        dd.font-mono = @generated_file_run.generator.presence || "-"
      div
        dt.font-semibold 出力ライター
        dd.font-mono = @generated_file_run.output_writer.presence || "-"
      div
        dt.font-semibold 発生元
        dd.flex.flex-wrap.items-center.gap-2
          span = generated_file_source_label(@generated_file_run.event_source)
          - if (badge_label = generated_file_source_badge_label(@generated_file_run.event_source))
            span.badge = badge_label
      div
        dt.font-semibold 開始
        dd = l(@generated_file_run.started_at, format: :long) if @generated_file_run.started_at
      div
        dt.font-semibold 完了
        dd = l(@generated_file_run.finished_at, format: :long) if @generated_file_run.finished_at

  - if (site_build_artifact_summary = generated_file_run_site_build_artifact_summary(@generated_file_run))
    .rounded-lg.border.border-blue-200.bg-blue-50.p-4
      h2.mb-3.text-lg.font-semibold.text-blue-800 Docusaurus site build artifact evidence
      p.mb-3.text-sm.text-blue-900 GitHub Actions artifact / workflow run と Rails 側 GeneratedFileRun evidence の役割差を、保存済み metadata だけで確認する read-only summary です。
      dl class="grid grid-cols-1 gap-3 text-sm md:grid-cols-2"
        - site_build_artifact_summary.fetch(:fields).each do |item|
          - label, value = item.split(": ", 2)
          div
            dt.font-semibold = label
            = " "
            dd.font-mono = value
      p.mt-3.text-xs.text-blue-900 この summary は replay / rebuild / artifact download / preview を実行しません。raw artifact、manifest 全文、CI log、import API request payload、secret-like value は表示対象にしません。

  - if search_hints.any?
    .rounded-lg.border.bg-white.p-4
      h2.mb-3.text-lg.font-semibold 一覧 q 検索の手掛かり
      p.mb-3.text-xs.text-gray-600 一覧の q 検索で使える短い候補だけを表示します。raw metadata、長い payload、token らしい値、private path は候補にしません。
      ul.flex.flex-wrap.gap-2.text-sm
        - search_hints.each do |hint|
          li
            = link_to admin_generated_file_runs_path(q: hint[:value]), class: "inline-flex items-center gap-2 rounded border px-3 py-2 hover:bg-gray-50" do
              span.font-semibold = hint[:label]
              span.font-mono = hint[:value]

  - if @retry_evidence_visible
    .rounded-lg.border.bg-white.p-4
      h2.mb-3.text-lg.font-semibold 再実行履歴
      dl class="grid grid-cols-1 gap-3 text-sm md:grid-cols-2"
        div
          dt.font-semibold 種別
          = " "
          dd = generated_file_run_retry_kind_label(@generated_file_run)
        div
          dt.font-semibold 再実行元
          = " "
          dd.font-mono
            - if @retry_of_generated_file_run_public_id.present?
              - if @retry_of_generated_file_run
                = link_to @retry_of_generated_file_run_public_id, admin_generated_file_run_path(@retry_of_generated_file_run_public_id, return_to: return_to_path), class: "text-blue-600 underline"
              - else
                = @retry_of_generated_file_run_public_id
            - else
              | -
        div
          dt.font-semibold 再実行依頼者
          dd = generated_file_run_retry_requester_label(@retry_requested_by_user_id, @retry_requested_by_user)
        div
          dt.font-semibold 再実行依頼時刻
          dd = @generated_file_run.metadata&.dig("retry_requested_at").presence || "-"
        div
          dt.font-semibold 確認先
          dd.font-mono = @generated_file_run.public_id
        div
          dt.font-semibold 運用runbook
          dd.font-mono docs/生成ファイル再試行と定期ジョブ管理runbook.md
      p.mt-3.text-xs.text-gray-600 既存の再実行 metadata から読める範囲だけを表示します。raw command、長い log、credential は表示対象にしません。

  - if @related_generated_file_event_public_ids.any? || @retry_child_runs.any?
    .rounded-lg.border.bg-white.p-4
      h2.mb-3.text-lg.font-semibold 関連情報

      - if @related_generated_file_event_public_ids.any?
        .mb-4
          h3.mb-2.text-sm.font-semibold 関連イベント
          ul.space-y-1.text-sm
            - @related_generated_file_event_public_ids.each do |public_id|
              - event = @related_generated_file_events_by_public_id[public_id]
              li
                - if event
                  = link_to public_id, admin_generated_file_event_path(public_id, return_to: return_to_path), class: "font-mono text-blue-600 underline"
                  span.muted = generated_file_event_status_label(event.status)
                - else
                  span.font-mono = public_id
                  span.muted （未検出）

      - if @retry_child_runs.any?
        div
          h3.mb-2.text-sm.font-semibold この実行から派生した再実行
          ul.space-y-1.text-sm
            - @retry_child_runs.each do |run|
              li
                = link_to run.public_id, admin_generated_file_run_path(run.public_id, return_to: return_to_path), class: "font-mono text-blue-600 underline"
                span.muted = generated_file_run_status_label(run.status)
                - if run.event_source == "generated_file_run_retry"
                  span.badge 再実行
                - elsif run.event_source == "generated_file_run_bulk_retry"
                  span.badge 一括再実行

  - if @generated_file_run.error_message.present?
    .rounded-lg.border.border-red-200.bg-red-50.p-4
      h2.mb-2.text-lg.font-semibold.text-red-700 エラー
      p.mb-2.text-xs.text-gray-600 エラーは診断用プレビューです。長い本文は省略され、token / secret / private path は伏せています。
      pre.whitespace-pre-wrap.text-sm = generated_file_run_diagnostic_preview(@generated_file_run.error_message)

  div class="grid grid-cols-1 gap-4 lg:grid-cols-2"
    .rounded-lg.border.bg-white.p-4
      h2.mb-2.text-lg.font-semibold 入力パス
      p.mb-2.text-xs.text-gray-600 入力パスはジョブ診断用の配列表示です。生成ジョブの入力を再確認する手がかりとして扱います。
      pre.whitespace-pre-wrap.text-sm = JSON.pretty_generate(@generated_file_run.source_paths || [])
    .rounded-lg.border.bg-white.p-4
      h2.mb-2.text-lg.font-semibold 変更ファイル
      p.mb-2.text-xs.text-gray-600 変更ファイルはジョブ診断用の配列表示です。生成前後の差分を再確認する手がかりとして扱います。
      pre.whitespace-pre-wrap.text-sm = JSON.pretty_generate(@generated_file_run.changed_files || [])
    .rounded-lg.border.bg-white.p-4
      h2.mb-2.text-lg.font-semibold 生成パス
      p.mb-2.text-xs.text-gray-600 生成パスはジョブ診断用の配列表示です。出力先の確認入口として扱います。
      pre.whitespace-pre-wrap.text-sm = JSON.pretty_generate(@generated_file_run.generated_paths || [])
    .rounded-lg.border.bg-white.p-4
      h2.mb-2.text-lg.font-semibold メタデータ
      p.mb-2.text-xs.text-gray-600 メタデータは診断用プレビューです。token / secret / private path は表示前に伏せています。
      pre.whitespace-pre-wrap.text-sm = generated_file_run_metadata_preview(@generated_file_run.metadata)
