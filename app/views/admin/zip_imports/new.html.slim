- page_title "ZIPインポート"
h1 ZIPインポート
= render "admin/nav"

.card
  .heading-with-help
    h2 ZIPファイルをアップロード
    = render InfoTooltipComponent.new(label: "ZIPインポート", description: "ZIP内のMarkdown・MDX文書と添付ファイルを解析し、dry-runで取り込み予定を確認してから実行します。この画面の送信だけでは文書を変更しません。")

  - project_options = @projects.map { |project| ["#{project.code} / #{project.name}", project.id] }
  = form_with url: admin_zip_imports_path, method: :post, local: true, html: { multipart: true } do |form|
    .form-grid
      .form-field
        = form.label :project_id do
          | 案件
          span.required-mark ※必須
        = form.rfk_select :project_id,
          collection: project_options,
          include_blank: "選択してください",
          placeholder: "選択してください",
          selected: params[:project_id],
          wrapper: false,
          html: { required: true }
      = form.rfk_text_field :version_label, wrapper: true, label: "版ラベル", placeholder: "例: zip-v1"
      = form.rfk_select :status,
        collection: enum_options_for("document_versions.status", DocumentVersion.statuses.keys),
        selected: params[:status].presence || "draft",
        wrapper: true,
        label: "取り込み後の状態"
      = form.rfk_text_field :source_repo, wrapper: true, label: "取り込み元リポジトリ・メモ", placeholder: "任意"
      = form.rfk_text_field :source_branch, wrapper: true, label: "取り込み元ブランチ", placeholder: "任意"
      = form.rfk_text_field :source_commit_hash, wrapper: true, label: "取り込み元コミット", placeholder: "任意"

    .file-dropzone data-controller="file-dropzone" data-file-dropzone-dragging-class="is-dragging"
      = form.label :zip_file, class: "file-dropzone__surface", data: { file_dropzone_target: "surface", action: "dragenter->file-dropzone#dragenter dragover->file-dropzone#dragover dragleave->file-dropzone#dragleave drop->file-dropzone#drop" } do
        span.file-dropzone__icon ZIP
        span.file-dropzone__title
          | ZIPファイルをドラッグ＆ドロップ
          span.required-mark ※必須
        span.file-dropzone__hint またはクリックしてファイルを選択
        span.file-dropzone__filename data-file-dropzone-target="filename" 選択されていません
      = form.file_field :zip_file, accept: ".zip,application/zip,application/x-zip-compressed", required: true, class: "file-dropzone__input", data: { file_dropzone_target: "input", action: "change->file-dropzone#change" }

    p.actions
      = form.submit "検証結果を作成", class: "button"
      = link_to "管理画面へ戻る", admin_root_path, class: "button secondary"
