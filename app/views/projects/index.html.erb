<% content_for :left_content do %>
  <%= render "documents/tree", projects: @projects, current_project: nil, current_document: nil %>
<% end %>

<% page_title "案件一覧" %>
<%= render PageHeaderComponent.new(
  title: "案件一覧",
  subtitle: "閲覧できる案件から文書を探します。案件を開くと、その案件の文書ツリーから目的の文書へ移動できます。"
) do |header| %>
  <% header.with_action do %>
    <%= link_to "ダッシュボード", dashboard_path, class: "button secondary" %>
  <% end %>
<% end %>

<div class="table-scroll" role="region" aria-label="閲覧可能な案件一覧" tabindex="0">
  <%= table_tag do %>
    <caption class="table-caption">閲覧可能な案件一覧</caption>
    <thead>
      <tr>
        <th>コード</th>
        <th>案件名</th>
        <th>説明</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <td><%= project.code %></td>
          <td><%= link_to project.name, project_path(project) %></td>
          <td><%= project.description %></td>
          <td class="project-list__action">
            <%= link_to project_path(project), class: "button secondary", aria: { label: "#{project.name}の文書を見る" } do %>
              <i class="bi bi-eye me-1" aria-hidden="true"></i>
              文書を見る
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  <% end %>
</div>
