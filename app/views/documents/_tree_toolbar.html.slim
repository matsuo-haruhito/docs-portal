- current_project = local_assigns[:current_project] || local_assigns[:current_document]&.project
- current_document = local_assigns[:current_document]
- render_state = local_assigns[:render_state]
- tree_projects = Array(local_assigns[:projects])
- tree_window_offset = document_tree_window_request_offset
- tree_query = document_tree_query
- tree_filter_project = current_project || tree_projects.first
- tree_filter_path = tree_filter_project.present? ? project_document_tree_path(tree_filter_project, document_slug: current_document&.slug, format: :turbo_stream) : nil
- if render_state.blank? && tree_projects.present?
  - render_state = document_tree_render_state(projects: tree_projects, current_project:, current_document:, expanded_source_path: local_assigns[:expanded_source_path], collapsed_source_path: local_assigns[:collapsed_source_path])
- toolbar_action_titles = { expand_all: "現在開いている案件の文書ツリーを全て展開します", collapse_all: "現在開いている案件の文書ツリーを全て閉じます" }
- toolbar_actions = render_state.present? ? tree_view_toolbar_actions(render_state, labels: { expand_all: "案件の文書ツリーを開く", collapse_all: "案件の文書ツリーを閉じる" }) : nil

#document_tree_toolbar.document-tree-toolbar
  .document-tree-toolbar__title-row
    h2 文書ツリー
  - if tree_filter_project.present?
    .document-tree-toolbar__search-row
      = form_with url: tree_filter_path, method: :get, class: "document-tree-toolbar__search-form", data: { turbo_stream: true } do |form|
        = form.rfk_search_field :tree_query, value: tree_query, placeholder: "文書・案件・顧客を検索", wrapper: false, html: { class: "document-tree-toolbar__search-input", aria: { label: "文書、案件、顧客の名称・フリガナ・コードなどで絞り込む" } }
        = form.submit "絞り込む", class: "document-tree-action-link"
        - if tree_query.present?
          = link_to "解除", tree_filter_path, class: "document-tree-action-link", data: { turbo_stream: true }
      - if current_document.present?
        p.muted.document-tree-scope-cue 検索は左のツリーだけを絞り込みます。
  - if current_project.present?
    .document-tree-toolbar__action-row
      - if toolbar_actions.present?
        .document-tree-actions aria-label="文書ツリー操作"
          - toolbar_actions.each do |action|
            - title = toolbar_action_titles.fetch(action[:action], action[:label])
            - if action[:path].present?
              = button_to action[:label], action[:path], method: :post, form: { data: { turbo_stream: true }.merge(action[:data]), title: }, class: "document-tree-action-link"
            - else
              = button_tag action[:label], type: "button", class: "document-tree-action-link", disabled: true, data: action[:data], title:
      - else
        .document-tree-actions aria-label="文書ツリー操作"
          = button_to "案件の文書ツリーを開く", document_tree_all_project_path(current_project, tree_action: "show", tree_query:, tree_window_offset:, format: :turbo_stream), method: :post, form: { data: { turbo_stream: true }, title: "現在開いている案件の文書ツリーを全て展開します" }, class: "document-tree-action-link"
          = button_to "案件の文書ツリーを閉じる", document_tree_all_project_path(current_project, tree_action: "hide", tree_query:, tree_window_offset:, format: :turbo_stream), method: :post, form: { data: { turbo_stream: true }, title: "現在開いている案件の文書ツリーを全て閉じます" }, class: "document-tree-action-link"
