<% page_title "ホーム" %>

<%
  pending_items = []
  pending_items << { label: "アクセス申請", count: @dashboard_stats[:pending_access_request_count], path: access_requests_path } if @dashboard_stats[:pending_access_request_count].to_i > 0
  pending_items << { label: "確認依頼", count: @dashboard_stats[:pending_approval_count], path: document_approval_requests_path } if current_user.internal? && @dashboard_stats[:pending_approval_count].to_i > 0
  pending_items << { label: "Q&A", count: @open_question_handoff_threads&.size || 0, path: document_approval_requests_path } if current_user.internal? && @open_question_handoff_threads&.any?
  has_pending = pending_items.any?
%>

<section class="home-workspace-summary">
  <span class="home-workspace-summary__item"><%= @dashboard_stats[:project_count] %>案件</span>
  <span class="home-workspace-summary__sep">&middot;</span>
  <span class="home-workspace-summary__item"><%= @dashboard_stats[:document_count] %>文書</span>
  <span class="home-workspace-summary__sep">&middot;</span>
  <span class="home-workspace-summary__item">保存済み<%= @dashboard_stats[:bookmark_count] %>件</span>
</section>

<% if has_pending %>
  <section class="home-section home-section--priority">
    <h2 class="home-section__title">
      <i class="bi bi-bell" aria-hidden="true"></i>
      要対応
    </h2>
    <div class="home-pending-list">
      <% pending_items.each do |item| %>
        <%= link_to item[:path], class: "home-pending-item", data: { turbo_frame: "_top" } do %>
          <span class="home-pending-item__label"><%= item[:label] %></span>
          <span class="home-pending-item__count"><%= item[:count] %></span>
        <% end %>
      <% end %>
    </div>
  </section>
<% else %>
  <p class="home-no-pending muted">現在、対応が必要な項目はありません。</p>
<% end %>

<section class="home-section">
  <h2 class="home-section__title">最近見た文書</h2>
  <% if @recent_documents.any? %>
    <ul class="home-document-list">
      <% @recent_documents.each do |document| %>
        <li class="home-document-list__item">
          <%= link_to project_document_path(document.project, document.slug), class: "home-document-list__link", data: { turbo_frame: "_top" } do %>
            <span class="home-document-list__title"><%= document.title %></span>
            <span class="home-document-list__meta muted"><%= document.project.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="home-section__more">
      <%= link_to "すべて見る", document_bookmarks_path(view: "recent"), data: { turbo_frame: "_top" } %>
    </p>
  <% else %>
    <p class="muted">最近見た文書はまだありません。<%= link_to "文書を探す", documents_path %></p>
  <% end %>
</section>

<div class="home-grid">
  <section class="home-section">
    <h2 class="home-section__title">保存済み</h2>
    <% if @favorite_bookmarks.any? || @read_later_bookmarks.any? %>
      <% if @favorite_bookmarks.any? %>
        <h3 class="home-subsection-title">お気に入り</h3>
        <ul class="home-document-list home-document-list--compact">
          <% @favorite_bookmarks.each do |bookmark| %>
            <li class="home-document-list__item">
              <%= link_to project_document_path(bookmark.document.project, bookmark.document.slug), class: "home-document-list__link", data: { turbo_frame: "_top" } do %>
                <span class="home-document-list__title"><%= bookmark.document.title %></span>
                <span class="home-document-list__meta muted"><%= bookmark.document.project.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if @read_later_bookmarks.any? %>
        <h3 class="home-subsection-title">後で読む</h3>
        <ul class="home-document-list home-document-list--compact">
          <% @read_later_bookmarks.each do |bookmark| %>
            <li class="home-document-list__item">
              <%= link_to project_document_path(bookmark.document.project, bookmark.document.slug), class: "home-document-list__link", data: { turbo_frame: "_top" } do %>
                <span class="home-document-list__title"><%= bookmark.document.title %></span>
                <span class="home-document-list__meta muted"><%= bookmark.document.project.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <p class="home-section__more">
        <%= link_to "ショートカット一覧", document_bookmarks_path, data: { turbo_frame: "_top" } %>
      </p>
    <% else %>
      <p class="muted">保存済みの文書はまだありません。</p>
    <% end %>
  </section>

  <section class="home-section">
    <h2 class="home-section__title">最近更新された文書</h2>
    <% if @recently_updated_documents.any? %>
      <ul class="home-document-list home-document-list--compact">
        <% @recently_updated_documents.each do |document| %>
          <li class="home-document-list__item">
            <%= link_to project_document_path(document.project, document.slug), class: "home-document-list__link", data: { turbo_frame: "_top" } do %>
              <span class="home-document-list__title"><%= document.title %></span>
              <span class="home-document-list__meta muted"><%= document.project.name %> / <%= l(document.updated_at, format: :short) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">最近更新された文書はありません。</p>
    <% end %>
  </section>

  <section class="home-section">
    <h2 class="home-section__title">案件</h2>
    <% if @projects.any? %>
      <ul class="home-document-list home-document-list--compact">
        <% @projects.each do |project| %>
          <li class="home-document-list__item">
            <%= link_to project_path(project), class: "home-document-list__link", data: { turbo_frame: "_top" } do %>
              <span class="home-document-list__title"><%= project.name %></span>
              <span class="home-document-list__meta muted"><%= project.code %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p class="home-section__more">
        <%= link_to "案件一覧", projects_path, data: { turbo_frame: "_top" } %>
      </p>
    <% else %>
      <p class="muted">閲覧可能な案件はありません。</p>
    <% end %>
  </section>
</div>
