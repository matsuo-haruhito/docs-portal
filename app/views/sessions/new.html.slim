- page_title "ログイン"

.login-shell
  section.card.login-card aria-labelledby="login-heading"
    .login-card__brand aria-hidden="true"
      span.login-card__brand-mark
      span docs-portal

    h1#login-heading ログイン
    p.muted 文書ポータルを利用するにはログインが必要です。

    = form_with url: session_path, scope: :session, data: { turbo: false } do |form|
      .form-grid.login-form-grid
        label
          | メールアドレス
          = form.email_field :email_address, autofocus: true, autocomplete: "username"
        label
          | パスワード
          = form.password_field :password, autocomplete: "current-password"
      .actions.login-card__actions
        = form.submit "ログイン", class: "button"

    = render GuidanceDisclosureComponent.new(title: "デモ用ログイン情報を確認", icon: "bi-person-lock") do
      p.muted
        | サンプル: `admin@example.com / password123!`
