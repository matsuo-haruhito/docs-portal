# ローカルapp + PostgreSQLの基本Compose構成
# 必要に応じてdocker-compose.kroki.ymlとdocker-compose.docusaurus.ymlを追加する
# Keep production values secret and provide them via deploy-time environment variables.
COMPOSE_FILE=docker-compose.yml

# Rails実行環境・ログ設定
RAILS_SERVE_STATIC_FILES=true
RAILS_FORCE_SSL=
RAILS_LOG_TO_STDOUT=
RAILS_LOG_SHIFT_AGE=5
RAILS_COLORIZE_LOGGING=true
RAILS_MAX_THREADS=5
APP_HOST=localhost
WEB_CONCURRENCY=0
SOLID_QUEUE_IN_PUMA=1
RAILS_MASTER_KEY=replace_me
SECRET_KEY_BASE=secret

# ローカルファイルの所有権に使用するコンテナユーザー
APP_UID=1000
APP_GID=1000

# ローカルPostgreSQLコンテナへの接続設定
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_NAME=docs_portal
DATABASE_PASSWORD=docs_portal

# ローカルストレージと内部API用トークン
ACTIVE_STORAGE_SERVICE=local
DOC_IMPORT_TOKEN=local-dev-import-token
DOCS_PORTAL_SYNC_TOKEN=local-dev-sync-token

# Webhook・生成ファイル・外部フォルダ同期のconsumer-first段階展開用（文書プレビューbuildは対象外）
JOB_RELIABILITY_V2_ENABLED=false

# Markdown / MDX手動プレビューの任意設定
# プレビューbuildを使う場合はdocker-compose.docusaurus.ymlと同時に有効化する
DOCUSAURUS_RENDERER_ENDPOINT=http://docusaurus:3000
DOCUSAURUS_RENDERER_MAX_UPLOAD_BYTES=20971520
DOCUSAURUS_RENDERER_MAX_SOURCE_FILES=2000
DOCUSAURUS_RENDERER_MAX_SOURCE_FILE_BYTES=20971520
DOCUSAURUS_RENDERER_MAX_SOURCE_BYTES=209715200
DOCUSAURUS_RENDERER_MAX_OUTPUT_BYTES=52428800
DOCUSAURUS_RENDERER_MAX_CONCURRENT_BUILDS=1
DOCUSAURUS_RENDERER_BUILD_TIMEOUT_MS=600000
DOCUSAURUS_RENDERER_READ_TIMEOUT_SECONDS=660
DOCUSAURUS_RENDERER_CPUS=2.0
DOCUSAURUS_RENDERER_MEMORY_LIMIT=9g
DOCUSAURUS_RENDERER_PIDS_LIMIT=384

# Docusaurusプレビュー・build用の図表レンダリング任意設定
# docker-compose.kroki.ymlと同時に有効化する
KROKI_ENDPOINT=http://kroki:8000

# 生成コマンド: bin/rails db:encryption:init
# 本番値は秘密情報として扱い、デプロイ時の環境変数から設定する
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace_me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace_me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace_me

# OAuthメタデータとWWW-Authenticate discoveryに使用する公開URL
# 本番では必須。例: https://docs.example.com
MCP_PUBLIC_BASE_URL=http://localhost:3000

# Google Driveプレビューfallback・同期用OAuthクライアント任意設定
GOOGLE_DRIVE_OAUTH_CLIENT_ID=replace_me
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_DRIVE_PREVIEW_FOLDER_ID=replace_me
GOOGLE_DRIVE_PREVIEW_UPLOAD_TTL_HOURS=168

# Docker Composeサービスをホストへ公開するポート
PUBLISH_WEB_SERVER_PORT=3000
PUBLISH_DATABASE_PORT=5432
PUBLISH_DOCUSAURUS_RENDERER_PORT=3001
PUBLISH_KROKI_PORT=8000
